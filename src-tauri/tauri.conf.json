{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriMusic",
  "version": "0.5.0",
  "identifier": "com.art3mis.taurimusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "TauriMusic",
        "width": 1280,
        "height": 832,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaSessionService"
      },
      {
        "create": false,
        "label": "tray",
        "title": "TauriMusic 托盘面板",
        "width": 360,
        "height": 192,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaSessionService"
      },
      {
        "create": false,
        "label": "lyrics",
        "title": "TauriMusic 桌面歌词",
        "width": 720,
        "height": 190,
        "minWidth": 420,
        "minHeight": 130,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaSessionService"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "name": "TauriMusic TMC 音乐包",
        "ext": [
          "tmc"
        ],
        "description": "TMC 音乐包(标准 7z:音频+歌词+封面+元数据)"
      },
      {
        "name": "TauriMusic TMCL 播放列表",
        "ext": [
          "tmcl"
        ],
        "description": "TMCL 播放列表(标准 7z:音乐文件+playlist.json)"
      },
      {
        "name": "TauriMusic TMCA 专辑",
        "ext": [
          "tmca"
        ],
        "description": "TMCA 专辑包(标准 7z:整张专辑音乐文件+歌词+封面+album.json)"
      },
      {
        "name": "TauriMusic MP3",
        "ext": [
          "mp3"
        ],
        "mimeType": "audio/mpeg",
        "description": "MP3 音频"
      },
      {
        "name": "TauriMusic FLAC",
        "ext": [
          "flac"
        ],
        "mimeType": "audio/flac",
        "description": "FLAC 音频"
      },
      {
        "name": "TauriMusic M4A",
        "ext": [
          "m4a"
        ],
        "mimeType": "audio/mp4",
        "description": "M4A 音频"
      },
      {
        "name": "TauriMusic WAV",
        "ext": [
          "wav"
        ],
        "mimeType": "audio/wav",
        "description": "WAV 音频"
      },
      {
        "name": "TauriMusic OGG",
        "ext": [
          "ogg"
        ],
        "mimeType": "audio/ogg",
        "description": "OGG 音频"
      },
      {
        "name": "TauriMusic OPUS",
        "ext": [
          "opus"
        ],
        "mimeType": "audio/ogg",
        "description": "OPUS 音频"
      }
    ],
    "windows": {
      "wix": {
        "template": "./wix/main.wxs",
        "language": [
          "zh-CN"
        ]
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ffmpeg.exe"
    ]
  }
}
